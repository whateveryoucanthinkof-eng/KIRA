# ==============================================================================
# cyberworld — .gitignore
# Excludes datasets, PCAPs, caches, secrets, node_modules, and local planning docs
# ==============================================================================

# --- Local planning / private docs (not for remote) ---
implementation.md

# --- Python Environment, Bytecode & Tooling Caches ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
# Root/Python dist only — do not blanket-ignore web_dashboard/dist if needed locally
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/
.ipynb_checkpoints
.cache/

# --- Virtual Environments ---
.env
.env.*
!.env.example
# Demo-mode flag for the dashboard. Carries no secret — only
# VITE_DEMO_MODE=true — and npm run demo does nothing without it.
!web_dashboard/.env.demo
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- Node / frontend ---
node_modules/
web_dashboard/node_modules/
web_dashboard/dist/
**/npm-debug.log*
yarn-error.log

# --- Containerlab Deployment & Runtime State ---
clab-*/
**/clab-*/
containerlab/clab-*/
.state.clab.yaml
*.state.clab.yaml
topology-data.json
ansible-inventory.yml
nornir-simple-inventory.yml

# --- Datasets & Heavy Telemetry ---
DATA/
CTU-13-Dataset/
data/
datasets/
raw_data/
raw_pcaps/
processed/
*.csv.gz
*.parquet
*.feather
*.h5
*.hdf5
*.zarr
data_processed/
telemetry_cache/
pcap_cache/
*.pcap
*.pcapng
*.pcap_ISCX.csv
!captures/live.pcap

# --- Model Weights, Checkpoints & Serialization ---
models/
model/models/
_deprecated_v31_model/
checkpoints/
checkpoints/*
*.pt
*.pth
*.ckpt
*.bin
*.onnx
*.safetensors
*.pkl
*.pickle
# Keep only the checkpoints the live app loads (see control_backend/model_adapter.py).
# Listed explicitly so retrain/backup artifacts cannot silently reappear in the tree.
!saved_models/branch_a/branch_a_lstm.pt
!saved_models/branch_b/host_wdt.pt
!saved_models/deepop/cwa_forecast_decoder.pt
!bita/saved_models/bita_bigru_transformer-warden_alerts.pth
!saved_models/**/*.manifest.json

# --- Logs, Temp & Scratch Directories ---
logs/
*.log
scratch/
artifacts/
temp/
tmp/
*.tmp
*.sqlite
*.db
/tmp/cyberworld_*

# --- Secrets & TLS Certificates ---
*.pem
*.key
*.cert
*.crt

# --- OS & IDE Metadata ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
.#*
\#*#
.~lock.*#
.~lock.*

# --- Media & Screen Recordings ---
*.mp4
*.webm
*.mov
*.mkv

# Transient training spill: memmapped feature blocks, 500MB+ each,
# rewritten continuously by a live run. Never an artefact worth versioning.
.spill/

# Regenerable from scripts/make_parity_fixture.py; 21MB of replayed capture.
captures/parity_states.jsonl
